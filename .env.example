# Domain Hunter — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# URL of your local TrueForge instance
# Start TrueForge with: npx @truefoundry/trueforge
TRUEFORGE_URL=http://localhost:8790

# NOTE: MCP API keys (EXA, Daytona, etc.) are configured INSIDE TrueForge
# via Settings → Connectors / Sandbox providers.
# They do NOT go in this file.
